{
  "name": "soups-unified-launcher",
  "version": "0.1.0",
  "private": true,
  "description": "Soups Unified Launcher (SUL) monorepo root",
  "workspaces": [
    "ui"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "tauri": "tauri",
    "ui:dev": "npm run dev --workspace ui",
    "ui:build": "npm run build --workspace ui",
    "ui:typecheck": "npm run typecheck --workspace ui",
    "ui:test": "npm test --workspace ui",
    "core:test": "cargo test -p sul-core",
    "core:lint": "cargo clippy -p sul-core --all-targets -- -D warnings"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4"
  }
}
